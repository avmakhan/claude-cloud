# Instellingen voor de webserver van Hostinger (LiteSpeed/Apache).

# --- Altijd HTTPS gebruiken ---
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Optioneel: www verplichten (haal de # weg als je dat wilt) ---
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Eigen 404-pagina ---
ErrorDocument 404 /404.html

# --- Verborgen bestanden blokkeren (zoals de map .git van Hostinger's Git-deployment) ---
RedirectMatch 404 /\.(?!well-known)

# --- Geen mappenlijst tonen ---
Options -Indexes

# --- Beveiligingsheaders ---
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Caching ---
<IfModule mod_headers.c>
  # Bestanden in /_astro/ krijgen een eigen regel: zie public/_astro/.htaccess
  # HTML altijd opnieuw controleren, zodat bezoekers direct de nieuwste versie zien.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Compressie ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>
